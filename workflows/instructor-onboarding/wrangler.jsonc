{
  "name": "instructor-onboarding",
  "main": "src/host/worker.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DRY_RUN": "true",
    "SAFETY_NET_NOT_BEFORE": "2026-10-12T09:19:56Z",
    "SLACK_CHANNEL_ID": "C09BK6Y2WHL",
    "SLACK_DRY_RUN_CHANNEL_ID": "C0C8CEZN64E"
  },
  "workflows": [
    {
      "name": "instructor-onboarding",
      "binding": "ONBOARDING_WORKFLOW",
      "class_name": "InstructorOnboardingWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTAKE_QUEUE",
        "queue": "instructor-onboarding-intake"
      }
    ],
    "consumers": [
      {
        "queue": "instructor-onboarding-intake",
        "max_retries": 5,
        "dead_letter_queue": "instructor-onboarding-intake-dlq"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "AIRTABLE_CURSOR",
      "id": "4c20b4595aa54066a791d522e09e52ed"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
