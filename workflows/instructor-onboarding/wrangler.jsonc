{
  "name": "instructor-onboarding",
  "main": "src/host/worker.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  // Live DRY_RUN and SAFETY_NET_NOT_BEFORE are not in this block.
  // `wrangler deploy` replaces every var with this file unless it is `wrangler deploy --keep-vars`.
  // Production deploys must pass --keep-vars. Preview defaults live under env.preview only.
  "vars": {
    "SLACK_CHANNEL_ID": "C09BK6Y2WHL",
    "SLACK_DRY_RUN_CHANNEL_ID": "C0C8CEZN64E"
  },
  "env": {
    "preview": {
      // No kv_namespaces. Wrangler must not attach the live AIRTABLE_CURSOR namespace.
      // Preview has no Xero login of its own, so DRY_RUN stays on and no Xero token is read.
      "name": "instructor-onboarding-preview",
      "vars": {
        "DRY_RUN": "true",
        "SAFETY_NET_NOT_BEFORE": "2099-01-01T00:00:00Z",
        "SLACK_CHANNEL_ID": "C0C8CEZN64E",
        "SLACK_DRY_RUN_CHANNEL_ID": "C0C8CEZN64E"
      },
      "workflows": [
        {
          "name": "instructor-onboarding-preview",
          "binding": "ONBOARDING_WORKFLOW",
          "class_name": "InstructorOnboardingWorkflow"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "INTAKE_QUEUE",
            "queue": "instructor-onboarding-preview-intake"
          }
        ],
        "consumers": [
          {
            "queue": "instructor-onboarding-preview-intake",
            "max_retries": 5,
            "dead_letter_queue": "instructor-onboarding-preview-intake-dlq"
          }
        ]
      },
      "triggers": {
        "crons": []
      }
    }
  },
  "workflows": [
    {
      "name": "instructor-onboarding",
      "binding": "ONBOARDING_WORKFLOW",
      "class_name": "InstructorOnboardingWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTAKE_QUEUE",
        "queue": "instructor-onboarding-intake"
      }
    ],
    "consumers": [
      {
        "queue": "instructor-onboarding-intake",
        "max_retries": 5,
        "dead_letter_queue": "instructor-onboarding-intake-dlq"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "AIRTABLE_CURSOR",
      "id": "4c20b4595aa54066a791d522e09e52ed"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
